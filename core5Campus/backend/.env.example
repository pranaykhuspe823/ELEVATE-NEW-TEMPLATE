# Copy to .env and edit.
PORT=4000
NODE_ENV=development

# Public URL of the site. Used in certificate QR codes and verification links.
PUBLIC_URL=http://localhost:3006

# Comma-separated list of allowed frontend origins (dev only; in production the API serves the frontend itself).
CORS_ORIGIN=http://localhost:3006

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret for server-to-server calls from a partner app (e.g. Elevate's
# faculty dashboard, which looks up a learner's certificates by email). Must
# match that app's copy of the same value. Generate the same way as JWT_SECRET.
SERVICE_KEY=

# First admin account, created on first start if no admin exists. Change the password after first login.
ADMIN_EMAIL=admin@core5.local
ADMIN_PASSWORD=ChangeMe@123

# SQLite file location
DB_FILE=./data/core5-educators.db



# Credly digital badges (https://info.credly.com/). Leave blank to skip sending badges to Credly.
# Get these from your Credly issuer organisation; set each course's badge template ID in Admin > Courses.
CREDLY_ORG_ID=
CREDLY_API_TOKEN=
# true = use Credly's sandbox while testing
CREDLY_SANDBOX=false
