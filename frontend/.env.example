VITE_API_BASE_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Optional: comma-separated substrings to prefer when picking the AI
# interviewer's voice on this machine/browser (e.g. "Aria,Jenny"). Leave
# unset to use the built-in female-voice heuristic.
VITE_INTERVIEW_VOICE_NAME_HINT=
# Core5 Campus (the separate faculty certification product): public site
# URL used for the "get certified" link on the faculty dashboard.
VITE_CORE5CAMPUS_URL=http://localhost:3006
