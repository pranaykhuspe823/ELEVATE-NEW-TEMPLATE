DATABASE_URL="postgresql://postgres:your_password@localhost:5432/elevate?schema=public"
PORT=4000
ML_SERVICE_URL="http://localhost:8001"
STORAGE_DIR="../storage/resumes"
FRONTEND_ORIGIN="http://localhost:5173"

# Google OAuth Client ID (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
# Anyone who signs in and knows this code can promote their own account to
# FACULTY via POST /api/auth/become-faculty. Share it only with real faculty.
FACULTY_INVITE_CODE=change_me_before_sharing
# Random secret used to sign session cookies -- generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here

LLM_PROVIDER=ollama
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
# ISO-639-1 language code pinned on Whisper transcription calls (AI mock
# interview answers) -- without this, ambiguous/accented speech can be
# auto-detected into the wrong language.
GROQ_WHISPER_LANGUAGE=en
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Vision-capable local model used for webcam proctoring checks (phone/extra-
# person detection). Pull it first: ollama pull moondream
OLLAMA_VISION_MODEL=moondream

# Optional: YouTube Data API v3 key (Google Cloud Console -> APIs & Services ->
# enable "YouTube Data API v3" -> Credentials -> API key). Enables live YouTube
# video/playlist results in the faculty course search; without it that search
# still returns Microsoft Learn results plus links to YouTube/Coursera/Udemy.
YOUTUBE_API_KEY=

# Required for the coding-question sandbox (C/C++ execution). Point these at
# a MinGW-w64 (or any gcc/g++) install. On Windows, WinLibs is a good option:
# https://winlibs.com -- if gcc/g++ are already on PATH, these can be left as
# bare commands instead of full paths.
GCC_PATH=gcc
GPP_PATH=g++

# Email address that receives "schedule a demo" lead notifications from the
# landing page. Requires SMTP_* below to be set too -- without them, demo
# requests are still saved to the database but only logged to the console
# instead of emailed.
DEMO_NOTIFY_EMAIL=you@yourcompany.com
# SMTP credentials for actually sending that email, e.g. a Gmail/Workspace
# account with an app password (https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@yourcompany.com,
# SMTP_PASS=<16-character app password>, SMTP_FROM=you@yourcompany.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Core5 Campus (faculty certification) shares this database: its tables live
# in their own schema. Must match core5Campus/backend/.env DB_SCHEMA.
CORE5_DB_SCHEMA=core5
# Core5 Campus API, for downloading certificate PDFs server-to-server.
# CORE5CAMPUS_SERVICE_KEY must equal core5Campus/backend/.env SERVICE_KEY.
CORE5CAMPUS_API_URL=http://localhost:4100
CORE5CAMPUS_SERVICE_KEY=

# Shared secret the ML service requires on every call (X-Service-Key).
# Must match ml-service/.env ML_SERVICE_KEY.
ML_SERVICE_KEY=
# Set to 1 when running behind a reverse proxy so rate limits see real client IPs.
TRUST_PROXY=

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_... keys
# while testing. KEY_SECRET never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<your-api>/api/webhooks/razorpay, events
# payment.captured, payment.failed, order.paid. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=
